{
  config,
  lib,
  pkgs,
  ...
}:
let
  inherit (lib) mkDefault mkEnableOption mkIf;
  cfg = config.features.wm.hyprland;

  # Each settings file receives `config.host`
  settingsFiles = [
    ./env.nix
    ./general.nix
    ./keybinds.nix
    ./rules.nix
    ./exec.nix
  ];
in
{
  imports = [
    ./hyprlock.nix
  ];

  options.features.wm.hyprland = {
    enable = mkEnableOption "Hyprland compositor and its desktop components";
  };

  config = mkIf cfg.enable {
    # Enable Hyprland
    wayland.windowManager.hyprland = {
      enable = true;
      xwayland.enable = true;
      systemd.enable = true;

      settings = lib.mkMerge (map (file: import file config.host) settingsFiles);

      extraConfig = ''
        # Source monitor and workspace configs generated by nwg-displays
        source = ~/.config/hypr/monitors.conf
        source = ~/.config/hypr/workspaces.conf
      '';
    };

    xdg.portal = {
      enable = true;

      extraPortals = with pkgs; [
        xdg-desktop-portal-gtk
      ];

      config = {
        common.default = "*";
        hyprland.default = [
          "hyprland"
          "gtk"
        ];
      };
    };

    features = {
      wm.hyprland.hyprlock.enable = mkDefault true;
      applications = {
        kitty.enable = mkDefault true; # terminal used by binds and rofi
        rofi.enable = mkDefault true;
        swaync.enable = mkDefault true;
        wallpapers.enable = mkDefault true;
        waybar.enable = mkDefault true;
        wlogout.enable = mkDefault true;
      };
    };

    # Essential Hyprland packages
    home.packages = with pkgs; [
      # Wayland essentials
      wayland
      wayland-protocols
      wayland-utils

      # Hyprland ecosystem
      nwg-displays

      # Wallpaper
      awww

      # Screenshot
      grim
      slurp
      grimblast

      # Media control
      playerctl

      # Audio control
      wireplumber
      pavucontrol

      # Brightness control
      brightnessctl

      # Clipboard manager (optional)
      wl-clipboard
      cliphist
    ];
  };
}
